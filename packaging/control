#!/usr/bin/python3 -I
"""Restricted root entry: only start this user's registered hotspot service."""
from pathlib import Path
import json
import os
import pwd
import stat
import sys

ROOT = Path('/usr/lib/hotspot-helper')

try:
    if os.geteuid() != 0 or sys.argv[1:] != ['start']:
        raise RuntimeError('此入口仅供授权用户启动热点。')
    uid = int(os.environ.get('SUDO_UID', '0'))
    if uid <= 0:
        raise RuntimeError('无法识别调用用户。')
    profile_path = Path('/etc/hotspot-helper/users', str(uid) + '.json')
    info = profile_path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError('授权文件权限异常。')
    profile = json.loads(profile_path.read_text())
    if profile['uid'] != uid or profile['username'] != pwd.getpwuid(uid).pw_name:
        raise RuntimeError('授权用户不一致。')
    config = Path(profile['config'])
    fd = os.open(config, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd) as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_mode & 0o077 or info.st_size > 16384:
            raise RuntimeError('个人热点配置权限异常。')
        data = json.load(stream)
    preferred = data.get('interface', 'auto')
    if not isinstance(preferred, str) or not preferred or len(preferred) > 32:
        raise RuntimeError('上游接口配置异常。')
    for path in [ROOT, ROOT / 'service_launcher.py']:
        info = path.stat()
        if info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError('程序文件必须由系统管理员拥有且不可被普通用户修改。')
    # -I excludes user Python paths; import only the administrator-owned library.
    sys.path.insert(0, str(ROOT))
    import service_launcher
    sys.argv = [str(ROOT / 'service_launcher.py'), '--', '--allow-roam', '--config', str(config), '--interface', preferred]
    service_launcher.main()
except Exception as error:
    print('未完成：' + str(error), flush=True)
    sys.exit(1)
